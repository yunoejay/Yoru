# Auth
AUTH_JWT_SECRET=change-me
APP_URL=http://localhost:3000

# Database (Postgres)
# Option A - local Homebrew Postgres (recommended for dev; trust auth, no password):
#   brew install postgresql@16
#   brew services start postgresql@16
#   /opt/homebrew/opt/postgresql@16/bin/createdb -h localhost -U "$USER" yoru
DATABASE_URL=postgresql://YOUR_MACOS_USERNAME@localhost:5432/yoru?schema=public
# Option B - hosted (Supabase/Neon): use the provider's DIRECT (port 5432) URI for
# migrations. Free hosted projects can pause when idle, and reads fail soft into
# bundled demo data, so the symptom is a silent revert to "demo" not an error.

# SMTP (optional; if not set, verification code prints to server console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# --- Content sources -------------------------------------------------------
# MangaDex (sanctioned public API). On by default.
# MangaDex requires a real, non-spoofed User-Agent. Set this to something that
# identifies your app plus a way to contact you, e.g.
#   SOURCE_USER_AGENT=YoruReader/0.1 (https://yourdomain.example; abuse@yourdomain.example)
SOURCE_USER_AGENT=
# Kept under MangaDex's ~5 requests/second per-IP global limit.
SOURCE_RATE_PER_SEC=4
# Set to true to re-enable the MangaDex source. It is OFF by default because its
# pages are proxied through rate-limited MangaDex@Home volunteer nodes and load
# noticeably slower than Atsumaru, which is the fast active source below.
MANGADEX_ENABLED=false

# Atsumaru (MangaBaka) - a fast, non-MangaDex source. It is a documented public
# JSON API (atsu.moe is a reader built on it), and its pages are served from its
# own CDN (cdn.atsu.moe) instead of the slow rate-limited MangaDex@Home nodes.
# Because it is an API source (not a scraper) it is ON by default; set to false
# to disable it. Credit Atsumaru/MangaBaka and the scanlation groups, and honour
# takedown requests, just as you would for MangaDex.
ATSUMARU_ENABLED=true
