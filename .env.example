# Yoru environment template.
#
# Never put real secrets in this file. For local development, pull the shared
# Development values from Vercel once:
#
#   npm install
#   npx vercel login
#   npx vercel link          # choose the yoru project
#   npm run env:pull         # writes .env.local (gitignored)
#
# Vercel's Development environment stores DATABASE_URL and AUTH_JWT_SECRET as
# "Config" values, so `vercel env pull` can read them. Production and Preview
# keep the same keys as "Secret": write-only, injected at deploy time, never
# pulled to a laptop.
#
# SECRET = a real credential; keep it in Vercel/vault, never commit it.
# CONFIG = non-sensitive value; safe to document here.
#
# Supabase note: Prisma connects straight to Postgres, so DATABASE_URL is the
# only Supabase value this app reads. No anon/publishable/service-role key is
# used by the code.

# Auth
# SECRET (Development: Vercel Config so `env:pull` can fetch it)
AUTH_JWT_SECRET=change-me
# CONFIG (absolute metadata URLs / links in email)
APP_URL=http://localhost:3000

# Database (Postgres)
# SECRET - contains the database password. Development uses a separate Supabase
# project (or local Postgres below); production uses its own DIRECT URI.
# Option A - local Homebrew Postgres (recommended for dev; trust auth, no password):
#   brew install postgresql@16
#   brew services start postgresql@16
#   /opt/homebrew/opt/postgresql@16/bin/createdb -h localhost -U "$USER" yoru
DATABASE_URL=postgresql://YOUR_MACOS_USERNAME@localhost:5432/yoru?schema=public
# Option B - hosted (Supabase/Neon): use the provider's DIRECT (port 5432) URI for
# migrations. Free hosted projects can pause when idle, and reads fail soft into
# bundled demo data, so the symptom is a silent revert to "demo" not an error.

# SMTP (optional; if not set, verification code prints to server console)
# CONFIG
SMTP_HOST=
# CONFIG
SMTP_PORT=
# SECRET
SMTP_USER=
# SECRET
SMTP_PASS=
# CONFIG
SMTP_FROM=no-reply@example.com

# --- Content sources -------------------------------------------------------
# MangaDex (sanctioned public API). On by default.
# CONFIG - MangaDex requires a real, non-spoofed User-Agent. Set this to
# something that identifies your app plus a way to contact you, e.g.
#   SOURCE_USER_AGENT=YoruReader/0.1 (https://yourdomain.example; abuse@yourdomain.example)
SOURCE_USER_AGENT=
# CONFIG - kept under MangaDex's ~5 requests/second per-IP global limit.
SOURCE_RATE_PER_SEC=4
# CONFIG - burst size for the shared limiter (defaults to 2).
SOURCE_BURST=2
# CONFIG - set to true to re-enable the MangaDex source. It is OFF by default
# because its pages are proxied through rate-limited MangaDex@Home volunteer
# nodes and load noticeably slower than Atsumaru, the fast active source below.
MANGADEX_ENABLED=false

# Atsumaru (MangaBaka) - a fast, non-MangaDex source. It is a documented public
# JSON API (atsu.moe is a reader built on it), and its pages are served from its
# own CDN (cdn.atsu.moe) instead of the slow rate-limited MangaDex@Home nodes.
# Because it is an API source (not a scraper) it is ON by default; set to false
# to disable it. Credit Atsumaru/MangaBaka and the scanlation groups, and honour
# takedown requests, just as you would for MangaDex.
# CONFIG
ATSUMARU_ENABLED=true
