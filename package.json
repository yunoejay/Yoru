{
  "name": "yoru",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "env:pull": "vercel env pull .env.local",
    "import:mangadex": "tsx --env-file=.env.local scripts/import-mangadex.ts",
    "import:atsumaru": "tsx --env-file=.env.local scripts/import-atsumaru.ts",
    "migrate:atsumaru": "tsx --env-file=.env.local scripts/migrate-to-atsumaru.ts",
    "add:scanlators": "tsx --env-file=.env.local scripts/add-atsumaru-scanlators.ts",
    "scanlators": "tsx --env-file=.env.local scripts/list-scanlators.ts",
    "icons:build": "tsx scripts/generate-icons.ts",
    "check:order": "tsx --env-file=.env.local scripts/check-reading-order.ts",
    "backfill:tags": "tsx --env-file=.env.local scripts/backfill-extra-tags.ts",
    "backfill:formats": "tsx --env-file=.env.local scripts/backfill-format-tags.ts",
    "check:read-progress": "tsx scripts/check-read-progress.ts",
    "check:updates-for-you": "tsx scripts/check-updates-for-you.ts",
    "check:env": "tsx scripts/check-env.ts",
    "themes:build": "tsx scripts/build-themes.ts",
    "themes:check": "tsx scripts/build-themes.ts --check",
