    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.19",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "latest",
    "postcss": "^8.4.31",
    "prisma": "^5.18.0",
    "sharp": "^0.35.4",
